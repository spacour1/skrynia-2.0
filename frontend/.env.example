# Backend API base URL. Next.js rewrites /api/* -> this address server-side.
# Under docker-compose, the frontend container uses http://backend:4000 (not localhost).
NEXT_PUBLIC_API_URL=http://localhost:4000

# WebSocket URL — browser-side, always the public/host-facing address.
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
# Enable only when a cross-origin production WS endpoint intentionally accepts the
# frontend's auth cookie instead of a one-time ticket.
NEXT_PUBLIC_WS_COOKIE_FALLBACK=false

# Canonical public URL of the frontend — used for metadataBase, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional additional exact WSS origins (no path/query/wildcard); empty by default.
NEXT_PUBLIC_WS_ORIGINS=

# Production builds require API, WS and SITE URLs. The canonical site must use HTTPS
# and its browser socket must use WSS. This exception is only for isolated local/CI
# builds with test-only services; leave false on staging and production.
FRONTEND_ALLOW_INSECURE_BUILD=false
# Start production rollout in report-only, verify browser violations, then rebuild
# with enforce. HSTS requires a guaranteed HTTPS frontend behind a trusted proxy.
FRONTEND_CSP_MODE=report-only
FRONTEND_HSTS_ENABLED=false
# Optional comma-separated exact HTTPS origins for legacy public images. New media
# uses same-origin /api/storage; never allow wildcards or private bucket endpoints.
NEXT_PUBLIC_MEDIA_ORIGINS=

# Compiles the payment-simulation panel into an explicit test build. The backend routes
# still require NODE_ENV=test and ENABLE_TEST_PAYMENTS=true; never enable this in a
# development, staging, or production build.
NEXT_PUBLIC_ENABLE_TEST_PAYMENTS=false

# Sentry error tracking — leave unset to disable (no overhead in CI/local dev).
# Get the DSN from https://sentry.io → Project Settings → Client Keys.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<host>/0
# Build-time only (not shipped to browser):
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=skrynia-frontend
# SENTRY_RELEASE=           # immutable release SHA shared with runtime telemetry
# SENTRY_AUTH_TOKEN=        # local/hosted builds only; Docker uses BuildKit secret

# PostHog product analytics — leave unset to disable entirely.
# Get the project API key from https://app.posthog.com → Project Settings.
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com  # existing EU default
# NEXT_PUBLIC_POSTHOG_ASSETS_HOST=https://eu-assets.i.posthog.com
